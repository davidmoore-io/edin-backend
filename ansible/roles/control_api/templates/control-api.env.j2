# {{ ansible_managed }}
# Control API environment — generated from Ansible vault

# Domain
SSG_DOMAIN={{ edin_domain }}
SSG_CONTROL_API_DOMAIN={{ edin_domain }}
SSG_CONTROL_BOT_DOMAIN={{ edin_domain }}
SSG_HTTP_ADDR=:8080
SSG_MCP_ADDR=:8081
SSG_HTTP_API_KEY={{ vault_http_api_key }}

# Claude AI
ANTHROPIC_API_KEY={{ vault_anthropic_api_key }}

# Discord
DISCORD_BOT_TOKEN={{ vault_discord_bot_token }}
DISCORD_APP_ID={{ discord_app_id }}
DISCORD_PUBLIC_KEY={{ vault_discord_public_key }}

# Memgraph (Docker network)
MEMGRAPH_ENABLED=true
MEMGRAPH_HOST={{ memgraph_host }}
MEMGRAPH_PORT={{ memgraph_port }}

# EDIN TimescaleDB (Docker network)
EDIN_DB_ENABLED=true
EDIN_DB_HOST={{ edin_db_host }}
EDIN_DB_PORT={{ edin_db_port }}
EDIN_DB_USER=edin_writer
EDIN_DB_PASSWORD={{ vault_edin_db_password }}
EDIN_DB_NAME=edin

# Commander DB roles (Docker network — edin_cmd_writer/reader, provisioned by db_roles.yml)
EDIN_CMD_WRITER_DSN=postgres://edin_cmd_writer:{{ vault_edin_cmd_writer_password }}@{{ edin_db_host }}:{{ edin_db_port }}/edin?sslmode=disable
EDIN_CMD_READER_DSN=postgres://edin_cmd_reader:{{ vault_edin_cmd_reader_password }}@{{ edin_db_host }}:{{ edin_db_port }}/edin?sslmode=disable

# EDDN TimescaleDB (Docker network)
EDDN_RAW_DB_ENABLED=true
EDDN_RAW_DB_HOST={{ eddn_db_host }}
EDDN_RAW_DB_PORT={{ eddn_db_port }}
EDDN_RAW_DB_USER=eddn_admin
EDDN_RAW_DB_PASSWORD={{ vault_eddn_db_password }}
EDDN_RAW_DB_NAME=eddn_raw

# Redis (Docker network)
CONVO_HISTORY_BACKEND=redis
CONVO_HISTORY_REDIS_ADDR=edin-redis:6379
CONVO_HISTORY_TTL=24h
CONVO_HISTORY_MAX_MESSAGES=20

# Kaine Portal auth (Authentik)
KAINE_AUTH_ENABLED={{ kaine_auth_enabled }}
KAINE_AUTH_JWKS_URL={{ kaine_auth_jwks_url }}
KAINE_AUTH_ISSUER={{ kaine_auth_issuer }}
KAINE_AUTH_AUDIENCE={{ kaine_auth_audience }}

# Authentik user management API (for admin page)
AUTHENTIK_API_ENABLED=true
AUTHENTIK_API_URL=https://auth.edin.space
AUTHENTIK_API_TOKEN={{ vault_authentik_api_token }}

# Commander auth
COMMANDER_AUTH_ENABLED={{ commander_auth_enabled }}
COMMANDER_JWT_PRIVATE_KEY_PATH={{ commander_jwt_private_key_path }}
COMMANDER_JWT_PUBLIC_KEY_PATH={{ commander_jwt_public_key_path }}
COMMANDER_JWT_ISSUER={{ commander_jwt_issuer }}
COMMANDER_JWT_EXPIRY={{ commander_jwt_expiry }}
COMMANDER_COOKIE_DOMAIN={{ commander_cookie_domain }}
COMMANDER_COOKIE_SECURE={{ commander_cookie_secure }}
FRONTIER_CLIENT_ID={{ vault_frontier_client_id }}
FRONTIER_CLIENT_SECRET={{ vault_frontier_client_secret }}
FRONTIER_AUTH_URL={{ frontier_auth_url }}
FRONTIER_CAPI_URL={{ frontier_capi_url }}
FRONTIER_SCOPE={{ frontier_scope }}
FRONTIER_CAPI_TIMEOUT={{ frontier_capi_timeout }}
PKCE_STATE_TTL={{ pkce_state_ttl }}
PKCE_MAX_PENDING={{ pkce_max_pending }}
COMMANDER_NONCE_EXPIRY={{ commander_nonce_expiry }}
COMMANDER_AUTH_INITIATE_RATE_LIMIT={{ commander_auth_initiate_rate_limit }}
COMMANDER_AUTH_INITIATE_RATE_WINDOW={{ commander_auth_initiate_rate_window }}
DESKTOP_REDIRECT_URI=https://{{ edin_domain }}/api/commander/auth/callback

# Copilot WebSocket tuning
COPILOT_WS_AUTH_TIMEOUT={{ copilot_ws_auth_timeout }}
COPILOT_WS_READ_DEADLINE={{ copilot_ws_read_deadline }}
COPILOT_WS_PING_INTERVAL={{ copilot_ws_ping_interval }}
COPILOT_WS_WRITE_DEADLINE={{ copilot_ws_write_deadline }}
COPILOT_WS_READ_LIMIT_BYTES={{ copilot_ws_read_limit_bytes }}
COPILOT_MESSAGE_HISTORY_LIMIT={{ copilot_message_history_limit }}
COPILOT_EVENTS_DEFAULT_LIMIT={{ copilot_events_default_limit }}
COPILOT_EVENTS_MAX_LIMIT={{ copilot_events_max_limit }}

# Galaxy data (served by Caddy)
GALAXY_DATA_DIR={{ galaxy_exporter_output_dir }}

# Operations (game server management via SSH to ssg.sh)
DOCKER_SERVICES=placeholder:placeholder

# LLM
LLM_MAX_TOOL_ITERATIONS=25
