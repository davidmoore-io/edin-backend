# {{ ansible_managed }}
services:
  control-api:
    build:
      context: {{ control_api_src_dir }}
      dockerfile: docker/control-api.Dockerfile
    container_name: control-api
    restart: unless-stopped
    env_file:
      - {{ control_api_env_file }}
    volumes:
      # Commander JWT keypair — generated on the host by jwt_keygen; read-only mount.
      - {{ commander_jwt_private_key_path | dirname }}:{{ commander_jwt_private_key_path | dirname }}:ro
      # Login-attempt audit log — created on the host by the access_list role.
      # Read-write so denials written inside the container land on the host
      # filesystem and survive container rebuilds. Operators tail the file
      # from the host (sudo tail -f /var/log/edin/login-attempts.log) —
      # there's no need for `docker exec`.
      - {{ commander_login_attempt_log | dirname }}:{{ commander_login_attempt_log | dirname }}:rw
    networks:
      - {{ edin_app_network }}
      - {{ edin_data_network }}
    healthcheck:
      test: ["CMD", "curl", "-sf", "http://localhost:8080/health"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    deploy:
      resources:
        limits:
          memory: 1G
        reservations:
          memory: 256M

  docker-inspect:
    # Tiny sidecar that holds the docker socket so control-api doesn't need
    # to. Single endpoint: GET /inspect/{name} with an embedded allowlist of
    # 4 container names. See edin-backend/cmd/docker-inspect-sidecar/.
    build:
      context: {{ control_api_src_dir }}
      dockerfile: cmd/docker-inspect-sidecar/Dockerfile
    container_name: docker-inspect
    restart: unless-stopped
    user: "65532:65532"
    group_add:
      # Host docker GID. Override per-host in inventory if it isn't 999.
      - "{{ docker_socket_gid | default(999) }}"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
    networks:
      - {{ edin_app_network }}
    # No host port published — only reachable from within the docker network.
    deploy:
      resources:
        limits:
          memory: 64M
        reservations:
          memory: 16M
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:8081/inspect/memgraph"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 5s

networks:
  {{ edin_app_network }}:
    external: true
  {{ edin_data_network }}:
    external: true
