# EDIN Backend — local development environment
# Copy this file and fill in secrets. Never commit secrets.
# Usage: set ENV_FILE=.env.dev in docker-compose, or source it before `go run`.

# ── Domain ────────────────────────────────────────────────────────────────────
SSG_DOMAIN=localhost
SSG_CONTROL_API_DOMAIN=localhost
SSG_CONTROL_BOT_DOMAIN=localhost
SSG_HTTP_ADDR=:8080
SSG_MCP_ADDR=:8081
SSG_HTTP_API_KEY=dev-internal-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-key>
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com

# ── ElevenLabs (voice TTS) ────────────────────────────────────────────────────
ELEVENLABS_API_KEY=<your-elevenlabs-key>
ELEVENLABS_VOICE_THE_MIND=tRXjpvqiDnZPEA7B2Izf
ELEVENLABS_VOICE_THE_ANALYST=Oa7ZtEdaNoSb1hXFIpZE
ELEVENLABS_VOICE_BOB_UK=LjZBisX2xAdJtahnQeBB
ELEVENLABS_VOICE_THE_VETERAN=SOWvz3ASTONJOosMtJsO
PERSONALITY_TEMPLATE_DIR=../edin-personality/system-prompts

# ── Discord ───────────────────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=<your-discord-bot-token>
DISCORD_APP_ID=<your-discord-app-id>
DISCORD_PUBLIC_KEY=<your-discord-public-key>

# ── Memgraph (comment out if not running locally) ─────────────────────────────
MEMGRAPH_ENABLED=false
# MEMGRAPH_HOST=localhost
# MEMGRAPH_PORT=7687

# ── EDIN TimescaleDB (comment out if not running locally) ─────────────────────
# Enable with local docker-compose.local.yml from edin-data (password: eddn-local-dev)
# Note: local docker-compose only creates edin_admin; production uses edin_writer (via Ansible vault)
EDIN_DB_ENABLED=false
# EDIN_DB_HOST=localhost
# EDIN_DB_PORT=5432
# EDIN_DB_USER=edin_admin   # local dev; production uses edin_writer
# EDIN_DB_PASSWORD=eddn-local-dev
# EDIN_DB_NAME=edin

# ── Commander DB roles ────────────────────────────────────────────────────────
# Used for the Copilot journal ingest/query and commander tools.
# `make quick-dev` overrides these with its namespaced local roles and also
# supplies EDIN_CMD_MIGRATOR_DSN so the embedded schema is applied.
# Set explicitly for other launch paths or leave empty to disable.
EDIN_CMD_WRITER_DSN=
# EDIN_CMD_WRITER_DSN=postgres://edin_cmd_writer:<pw>@localhost:5432/edin?sslmode=disable
EDIN_CMD_READER_DSN=
# EDIN_CMD_READER_DSN=postgres://edin_cmd_reader:<pw>@localhost:5432/edin?sslmode=disable

# ── EDDN raw feed (comment out if not running locally) ───────────────────────
# Enable with local docker-compose.local.yml from edin-data (password: eddn-local-dev)
EDDN_RAW_DB_ENABLED=false
# EDDN_RAW_DB_HOST=localhost
# EDDN_RAW_DB_PORT=5433
# EDDN_RAW_DB_USER=eddn_admin
# EDDN_RAW_DB_PASSWORD=eddn-local-dev
# EDDN_RAW_DB_NAME=eddn_raw

# ── Redis (in-memory fallback used if disabled) ───────────────────────────────
CONVO_HISTORY_BACKEND=memory
# CONVO_HISTORY_BACKEND=redis
# CONVO_HISTORY_REDIS_ADDR=localhost:6379
CONVO_HISTORY_TTL=24h
CONVO_HISTORY_MAX_MESSAGES=20

# ── Commander auth ────────────────────────────────────────────────────────────
COMMANDER_AUTH_ENABLED=true
COMMANDER_JWT_PRIVATE_KEY_PATH=./dev-keys/commander-private.pem
COMMANDER_JWT_PUBLIC_KEY_PATH=./dev-keys/commander-public.pem
COMMANDER_JWT_ISSUER=edin-space
COMMANDER_JWT_EXPIRY=24h
COMMANDER_COOKIE_DOMAIN=
COMMANDER_COOKIE_SECURE=false

# Frontier OAuth2 — register these redirect URIs on the Frontier developer portal:
#   https://edin.space/api/commander/auth/callback              (production desktop)
#   https://edin-dev.crossmoore.io.ngrok.app/api/commander/auth/callback  (ngrok desktop)
#   https://edin.space/copilot/callback                        (production copilot)
#   https://edin-dev.crossmoore.io.ngrok.app/copilot/callback  (ngrok copilot)
FRONTIER_CLIENT_ID=<your-frontier-client-id>
FRONTIER_CLIENT_SECRET=<your-frontier-client-secret>

# Desktop auth redirect URI (override for local dev with ngrok)
DESKTOP_REDIRECT_URI=https://edin-dev.crossmoore.io.ngrok.app/api/commander/auth/callback
FRONTIER_AUTH_URL=https://auth.frontierstore.net
FRONTIER_CAPI_URL=https://companion.orerve.net
FRONTIER_SCOPE=auth capi
FRONTIER_CAPI_TIMEOUT=10s

# PKCE / nonce
PKCE_STATE_TTL=10m
PKCE_MAX_PENDING=1000
COMMANDER_NONCE_EXPIRY=10s

# Per-IP rate limit for /initiate
COMMANDER_AUTH_INITIATE_RATE_LIMIT=5
COMMANDER_AUTH_INITIATE_RATE_WINDOW=1m

# ── Copilot WebSocket tuning ──────────────────────────────────────────────────
COPILOT_WS_AUTH_TIMEOUT=5s
COPILOT_WS_READ_DEADLINE=60s
COPILOT_WS_PING_INTERVAL=30s
COPILOT_WS_WRITE_DEADLINE=10s
COPILOT_WS_READ_LIMIT_BYTES=65536
COPILOT_MESSAGE_HISTORY_LIMIT=20
COPILOT_EVENTS_DEFAULT_LIMIT=20
COPILOT_EVENTS_MAX_LIMIT=100

# ── LLM ──────────────────────────────────────────────────────────────────────
LLM_MAX_TOOL_ITERATIONS=25

# ── Operations (minimal for local dev) ───────────────────────────────────────
DOCKER_SERVICES=placeholder:placeholder

# ── Logging ──────────────────────────────────────────────────────────────────
SSG_LOG_JSON=false

# ── Kaine auth — local quick-dev Authentik ───────────────────────────────────
# `make quick-dev` creates this public client and grants authenticated local
# users the kaine-god development claim. Production uses auth.edin.space.
KAINE_AUTH_ENABLED=true
KAINE_AUTH_CLIENT_ID=kaine-portal
KAINE_AUTH_JWKS_URL=http://127.0.0.1:9000/application/o/kaine-portal/jwks/
KAINE_AUTH_ISSUER=http://127.0.0.1:9000/application/o/kaine-portal/
KAINE_AUTH_AUDIENCE=kaine-portal
KAINE_AUTH_TOKEN_URL=http://127.0.0.1:9000/application/o/token/
KAINE_AUTH_COOKIE_DOMAIN=
KAINE_AUTH_COOKIE_SECURE=false

# ── Authentik admin API ───────────────────────────────────────────────────────
# quick-dev supplies the bootstrap token from its ignored vaulted secrets file.
AUTHENTIK_API_ENABLED=true
AUTHENTIK_API_URL=http://127.0.0.1:9000
